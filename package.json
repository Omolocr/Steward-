{
  "name": "church-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "check:release": "node scripts/check-release.mjs",
    "configure": "node scripts/configure-app.mjs",
    "eas-build-pre-install": "node -e \"if(process.env.EAS_BUILD_PROFILE==='production')require('child_process').execSync('node scripts/check-release.mjs',{stdio:'inherit'})\"",
    "test": "node server/run-all-tests.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.0",
    "expo-av": "~15.1.7",
    "expo-constants": "~17.1.7",
    "expo-file-system": "~18.1.11",
    "expo-notifications": "~0.31.4",
    "expo-speech": "~13.1.7",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.5"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "private": true
}
