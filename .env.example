# Copy this file to ".env" and fill it in:   cp .env.example .env
# Never share the .env file or put it in a chat/email: it holds your keys.

# ---- Your address (the DNS "A" record must point to this server) -------------
DOMAIN=api.yourchurch.org

# ---- Security ----------------------------------------------------------------
# Make one with:  openssl rand -hex 32     (the server refuses to start without a long secret)
TOKEN_SECRET=

# ---- How many churches? (read DEVELOPER-GUIDE.md) ------------------------------
# MANY CHURCHES (you are the app developer): list the developer team's phones, up to 10. Format  phone:Name  separated by commas.
# They sign in at https://your-address/console and create each church there; every church gets its own special church number.
DEVELOPERS=0712345678:Your Name
# ONE CHURCH only: instead of the line above, write the church's name. Nobody then has to type a church number.
# DEFAULT_CHURCH=Nanyuki Central SDA Church

# One-church mode only: the first Secretary and Pastor, approved automatically when they first sign up.
# Format  phone:role  separated by commas.  You can remove this line after they have signed up.
# (With many churches, each church's Admin approves its own Secretary and Pastor inside the app.)
# BOOTSTRAP=0712345678:secretary,0723456789:pastor

# ---- SMS (Africa's Talking) ---------------------------------------------------
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
# Optional approved sender name (e.g. your church name). Leave empty to use the default sender.
AT_SENDER_ID=
# Also text receipts to members when the Treasurer confirms a payment (1 = yes, 0 = no).
SMS_RECEIPTS=1

# ---- Sermon summaries ---------------------------------------------------------
# Speech-to-text (turns the recording into text)
OPENAI_API_KEY=
# Optional: force the sermon language, "en" or "sw". Leave empty to detect automatically.
TRANSCRIBE_LANGUAGE=
# AI that writes the summaries
ANTHROPIC_API_KEY=
# Longest full summary, in minutes of listening
SUMMARY_MAX_MINUTES=30

# ---- Automatic M-Pesa checking (Safaricom Daraja) --------------------------------
# Optional. Leave MPESA_CALLBACK_SECRET empty to run without it: the Treasurer then confirms every payment by hand.
# When on, the server learns about every payment to your Pay Bill and marks member payments "Verified by M-Pesa".
# Make the secret with:  openssl rand -hex 32     (it becomes part of the private address Safaricom calls; keep it secret)
MPESA_CALLBACK_SECRET=
# Your Pay Bill number (payments to any other number are ignored)
MPESA_SHORTCODE=
# 0 = the Treasurer still taps "Received" (recommended to start). 1 = a verified payment is receipted automatically.
MPESA_AUTO_RECEIPT=0

# ---- Backups -----------------------------------------------------------------
# Number of daily database snapshots to keep (minimum 7)
BACKUP_KEEP=60
# Optional: copy every backup to another place, for example with rclone:
# BACKUP_HOOK=rclone copy "$BACKUP_FILE" myremote:church-backups/

# ---- Reminders (gentle nudges when something has waited too long) --------------
# REMINDERS=off switches them off. Defaults: nudge after 48 hours, at most once a day per kind, 7:00-20:00 Kenya time.
# REMINDER_AFTER_HOURS=48
# REMINDER_EVERY_HOURS=24

# ---- Push notifications (phone alerts) ----------------------------------------
# console = only write them to the server log (default, for practice)   expo = send to real phones   off = none
PUSH_PROVIDER=console
# Optional, only if you turned on "enhanced push security" in your Expo account:
# EXPO_ACCESS_TOKEN=

# Team quick entry for the developer/development team on a SANDBOX server (made-up data only).
# Reserved numbers 0700000001-0700000010 (developer console), 0700000101 (Church Admin), 0700000201-221 (leaders), 0700000301-305 (members) sign in with no code.
# The server refuses to start if this is combined with PERSISTENT_STORAGE=yes.
# SANDBOX_ACCESS=yes
